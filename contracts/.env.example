# Private key wallet deployer (pakai wallet khusus testnet, JANGAN wallet utama)
PRIVATE_KEY=

# RPC endpoints (default publik sudah oke untuk testnet)
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
OPBNB_TESTNET_RPC=https://opbnb-testnet-rpc.bnbchain.org

# Untuk verifikasi kontrak di BSCScan (https://bscscan.com/myapikey)
BSCSCAN_API_KEY=

# Wallet backend yang akan diberi AUTHENTICATOR_ROLE saat deploy (opsional)
BACKEND_AUTHENTICATOR_ADDRESS=
