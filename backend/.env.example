PORT=3000
# Base URL untuk link verifikasi publik yang dikembalikan API (QR mengarah ke sini)
PUBLIC_VERIFY_BASE_URL=http://localhost:3000

# ── Part 1/2: On-chain (BSC Testnet) ─────────────────────────────
# Kosongkan ketiganya = MOCK MODE (untuk dev Android paralel tanpa kontrak)
BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
CONTRACT_ADDRESS=
# Wallet backend pemegang AUTHENTICATOR_ROLE (khusus testnet!)
AUTHENTICATOR_PRIVATE_KEY=

# ── Part 3: AI Authentication (Google Gemini, punya vision) ──────
# Kosongkan AI_API_KEY = mock mode (skor selalu 92).
# Gemini bisa menganalisis foto (DeepSeek V4 tidak). API key gratis, tanpa kartu:
#   https://aistudio.google.com/apikey
# Provider OpenAI-compatible lain juga bisa (ganti AI_BASE_URL + AI_MODEL).
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.0-flash
# Skor minimal untuk auto-mint; di bawah ini = flagged for manual review (PRD §6.1)
AUTH_SCORE_THRESHOLD=70

# ── Part 4: BNB Greenfield Testnet ───────────────────────────────
GREENFIELD_RPC_URL=https://gnfd-testnet-fullnode-tendermint-us.bnbchain.org
GREENFIELD_CHAIN_ID=5600
GREENFIELD_BUCKET=origintag-evidence
GREENFIELD_PRIVATE_KEY=
